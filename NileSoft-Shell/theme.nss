theme
{
	name = "modern"

	view = view.medium

	background
	{
		color = #F0E4cc
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100

		prefix = 1

		text
		{
			normal = #182430
			select = #182430
			normal-disabled = #c0c0a8
			select-disabled = #c0c0a8
		}

		back
		{
			select = #818f9a
			select-disabled = #c0c0a8
		}
	}

	font
	{
		size = 21
		name = "Segoe UI Variable Text"
		weight = 1
		italic = 0
	}

	border
	{
		enabled = true
		size = 1
		color = #182430
		opacity = 100
		radius = 20
	}

	shadow
	{
		enabled = false
		size = 5
		opacity = 5
		color = #11111b
	}

	separator
	{
		size = 1
		color = #c0c0a8
	}

	symbol
	{
		normal = #182430
		select = #182430
		normal-disabled = #4B565C
		select-disabled = #4B565C
	}

	image
	{
		enabled = true
		color = [#182430, #182430, #182430]
	}
}